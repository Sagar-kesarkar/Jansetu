# ---------------------------------------------------------------------------
# Optional Gemini credential for AI features; leave empty for fallback mode.
# Live channel providers require separate credentials and terms review.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Confirm model access and free-tier eligibility for your account before use.
# If a model is unavailable, check the account's supported models and configure
# GEMINI_MODEL and GEMINI_MODEL_FALLBACKS. A 404 alone does not prove retirement.
GEMINI_MODEL=gemini-3.5-flash

# ---- App & Public URLs ----
DATABASE_URL=sqlite:///./jansetu.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080
OFFICIALS_CONSOLE_ORIGIN=http://localhost:5174

# ---- Exotel IVR & SMS (Production) ----
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_EXOPHONE=
EXOTEL_SMS_SENDER_ID=JANSTU
EXOTEL_REGION=mumbai
EXOTEL_APP_ID=
EXOTEL_WEBHOOK_SECRET=
EXOTEL_STREAM_ENABLED=false

# ---- India DLT SMS Compliance ----
DLT_ENTITY_ID=
DLT_SUCCESS_TEMPLATE_ID=
DLT_LOCATION_TEMPLATE_ID=
DLT_FAILURE_TEMPLATE_ID=
DLT_STATUS_TEMPLATE_ID=

# ---- Meta WhatsApp Business Cloud API ----
WHATSAPP_VERIFY_TOKEN=local_dev_token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0

# ---- Telephony Prompts & Limits ----
IVR_PROMPT_DIR=data/ivr_prompts
MAX_AUDIO_BYTES=10485760
MAX_IMAGE_BYTES=10485760

# Keys the HMAC that turns inbound phone numbers into opaque citizen refs
# (services/privacy.py). Leave blank and a random one is generated per process,
# which is safe but makes refs non-comparable across restarts. Set it to any
# long random string for a real deployment — and treat it as a secret, because
# it is the only thing standing between the database and a reversible number.
CITIZEN_REF_SALT=

# ---- Optional upgrade path, off by default (needs GCP billing) ----
USE_DEDICATED_ASR=false
