# The only configuration the frontend has.
#
# Left unset, the app talks to http://localhost:8080 — which is what `make dev`
# starts, so a fresh clone works with no .env at all.
#
# For a Netlify build pointed at the deployed Hugging Face Space, set this in the
# Netlify UI (Site settings -> Environment variables) as well as here: Vite inlines
# it at build time, so changing it later means rebuilding, not restarting.
VITE_API_BASE=http://localhost:8080
